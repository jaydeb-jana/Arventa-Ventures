<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" 
    xmlns:html="http://www.w3.org/TR/REC-html40"
    xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>

  <xsl:template match="/">
    <html xmlns="http://www.w3.org/1999/xhtml" lang="en">
      <head>
        <title>XML Sitemap | Arventa Ventures</title>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <style type="text/css">
          * {
            box-sizing: border-box;
          }
          body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
            color: #334155;
            background-color: #020617;
            margin: 0;
            padding: 24px 16px;
          }
          #content {
            max-width: 1140px;
            margin: 0 auto;
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
          }
          h1 {
            font-size: 24px;
            margin: 0 0 8px 0;
            font-weight: 700;
            color: #ffffff;
          }
          .expl {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 12px;
            line-height: 1.5;
          }
          .expl a {
            color: #f97316;
            text-decoration: none;
            font-weight: 600;
          }
          .expl a:hover {
            text-decoration: underline;
          }
          .count-pill {
            display: inline-block;
            background: #1e293b;
            border: 1px solid #334155;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            color: #cbd5e1;
            margin-bottom: 20px;
          }
          .count-pill strong {
            color: #f97316;
          }
          table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
          }
          th {
            text-align: left;
            padding: 10px 12px;
            font-weight: 600;
            border-bottom: 1px solid #334155;
            background-color: #1e293b;
            color: #e2e8f0;
          }
          td {
            padding: 10px 12px;
            border-bottom: 1px solid #1e293b;
            vertical-align: middle;
            color: #cbd5e1;
          }
          tr:hover td {
            background-color: rgba(30, 41, 59, 0.5);
          }
          td a {
            color: #38bdf8;
            text-decoration: none;
            word-break: break-all;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 12.5px;
          }
          td a:hover {
            color: #f97316;
            text-decoration: underline;
          }
          .badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 11px;
            background: rgba(249, 115, 22, 0.15);
            color: #f97316;
            border: 1px solid rgba(249, 115, 22, 0.3);
          }
          .footer {
            margin-top: 24px;
            padding-top: 14px;
            border-top: 1px solid #1e293b;
            font-size: 12px;
            color: #64748b;
            text-align: center;
          }
          .footer a {
            color: #f97316;
            text-decoration: none;
          }
          @media (max-width: 768px) {
            th:nth-child(4), td:nth-child(4) {
              display: none;
            }
          }
        </style>
      </head>
      <body>
        <div id="content">
          <h1>XML Sitemap</h1>
          <p class="expl">
            This XML sitemap is generated by <a href="https://arventaventures.online">Arventa Ventures</a> for search engines (Google, Bing). 
            Headquarters: Contai (Kanthi), Purba Medinipur, West Bengal 721401.
          </p>

          <xsl:choose>
            <!-- IF SITEMAPINDEX -->
            <xsl:when test="//*[local-name()='sitemapindex']">
              <div class="count-pill">
                Number of Sitemaps: <strong><xsl:value-of select="count(//*[local-name()='sitemap'])"/></strong>
              </div>

              <table>
                <thead>
                  <tr>
                    <th style="width: 50px;">#</th>
                    <th>Sitemap</th>
                    <th style="width: 160px;">Last Modified</th>
                  </tr>
                </thead>
                <tbody>
                  <xsl:for-each select="//*[local-name()='sitemap']">
                    <tr>
                      <td style="color:#64748b;"><xsl:value-of select="position()"/></td>
                      <td>
                        <a href="{*[local-name()='loc']}"><xsl:value-of select="*[local-name()='loc']"/></a>
                      </td>
                      <td style="color:#94a3b8;"><xsl:value-of select="*[local-name()='lastmod']"/></td>
                    </tr>
                  </xsl:for-each>
                </tbody>
              </table>
            </xsl:when>

            <!-- IF URLSET -->
            <xsl:otherwise>
              <div class="count-pill">
                Number of URLs in this sitemap: <strong><xsl:value-of select="count(//*[local-name()='url'])"/></strong>
              </div>

              <table>
                <thead>
                  <tr>
                    <th style="width: 50px;">#</th>
                    <th>URL</th>
                    <th style="width: 100px;">Priority</th>
                    <th style="width: 130px;">Change Freq</th>
                    <th style="width: 150px;">Last Modified</th>
                  </tr>
                </thead>
                <tbody>
                  <xsl:for-each select="//*[local-name()='url']">
                    <tr>
                      <td style="color:#64748b;"><xsl:value-of select="position()"/></td>
                      <td>
                        <a href="{*[local-name()='loc']}"><xsl:value-of select="*[local-name()='loc']"/></a>
                      </td>
                      <td>
                        <span class="badge"><xsl:value-of select="*[local-name()='priority']"/></span>
                      </td>
                      <td style="color:#a7f3d0;"><xsl:value-of select="*[local-name()='changefreq']"/></td>
                      <td style="color:#94a3b8;"><xsl:value-of select="*[local-name()='lastmod']"/></td>
                    </tr>
                  </xsl:for-each>
                </tbody>
              </table>
            </xsl:otherwise>
          </xsl:choose>

          <div class="footer">
            <a href="https://arventaventures.online">Arventa Ventures</a> • Premier Digital Marketing, Web &amp; App Development
          </div>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
